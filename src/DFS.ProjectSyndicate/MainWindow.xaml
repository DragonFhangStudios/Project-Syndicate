<Window x:Class="DFS.ProjectSyndicate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DFS.ProjectSyndicate.Views"
        xmlns:toolTipService="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="Project Syndicate" Height="600" Width="1000"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <TextBlock Text="PROJECT SYNDICATE"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="MENU" Style="{StaticResource SubHeaderTextStyle}" Margin="10,0,0,10" FontSize="12"/>

                <Button Content="📊 Dashboard" Click="Dashboard_Click" Height="40" HorizontalContentAlignment="Left" Padding="15,0"/>
                <Button Content="💼 Jobs" Click="JobsTab_Click" Height="40" HorizontalContentAlignment="Left" Padding="15,0"/>
                <Button Content="🔒 Crimes"
                        IsEnabled="False"
                        ToolTip="🚧 Feature not enabled yet"
                        ToolTipService.ShowOnDisabled="True"
                        Height="40"
                        HorizontalContentAlignment="Left"
                        Padding="15,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Padding="20">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
