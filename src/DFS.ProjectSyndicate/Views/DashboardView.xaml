<UserControl x:Class="DFS.ProjectSyndicate.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DFS.ProjectSyndicate.ViewModels"
             x:Name="DashboardRoot">
    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header -->
            <TextBlock Text="Welcome to Project Syndicate" Style="{StaticResource HeaderTextStyle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Player Info Card -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,10,15">
                    <StackPanel>
                        <TextBlock Text="{Binding Player.Name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding LevelDisplay}" FontSize="14" Margin="0 2"/>
                        <TextBlock Text="{Binding XPDisplay}" FontSize="14" Margin="0 2"/>

                        <TextBlock FontSize="14" Margin="0,10,0,2">
                            <Run Text="Cash: $" Foreground="{StaticResource SuccessBrush}"/>
                            <Run Text="{Binding Player.Cash, StringFormat=N0}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Tier/Rank Card -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}" Background="{StaticResource PrimaryBrush}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Current Rank"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Opacity="0.8"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RankDisplay}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0 5 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Stats Section -->
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,10,15">
                    <StackPanel>
                        <TextBlock Text="💪 Character Stats" Style="{StaticResource SubHeaderTextStyle}"/>

                        <TextBlock Margin="0 5">
                            <Run Text="Strength: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding Player.Strength}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        </TextBlock>
                        <TextBlock Margin="0 5">
                            <Run Text="Intellect: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding Player.Intellect}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </TextBlock>
                        <TextBlock Margin="0 5">
                            <Run Text="Endurance: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding Player.Endurance}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Current Job Section -->
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="💼 Employment Status" Style="{StaticResource SubHeaderTextStyle}"/>

                        <TextBlock Text="{Binding CurrentJobTitle}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0 5"/>
                        <TextBlock Text="{Binding JobEarnings}"
                                   FontSize="14"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0 5"/>
                    </StackPanel>
                </Border>

                <!-- Promotion Section -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📈 Career Advancement" Style="{StaticResource SubHeaderTextStyle}"/>

                        <TextBlock Text="{Binding PromotionInfo}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0 0 0 15"/>

                        <Button Content="🎯 Apply for Promotion"
                                Command="{Binding PromoteCommand}"
                                IsEnabled="{Binding CanPromote}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="20,10"/>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
