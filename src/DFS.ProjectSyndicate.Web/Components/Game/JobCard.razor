@* Job board listing: terms, requirements and the accept action. Locked jobs show what unlocks them. *@
<article class="job-card @(IsLocked ? "is-locked" : null)" aria-labelledby="@HeadingId">
    <div class="job-head">
        <div class="job-eyebrow">
            <p class="eyebrow eyebrow-crimson">Civilian contract</p>
            @if (IsLocked)
            {
                <span class="job-lock"><Icon Name="lock" /> Locked</span>
            }
        </div>
        <h3 id="@HeadingId" class="job-title">@Job.Title</h3>
        <p class="muted">@Job.Description</p>
    </div>

    <dl class="job-terms">
        <div>
            <dt>Pay</dt>
            <dd class="text-gold tabular">@Format.Money(Job.Payout)</dd>
        </div>
        <div>
            <dt>Experience</dt>
            <dd class="tabular">+@Job.XPReward XP</dd>
        </div>
        <div>
            <dt>Tasks</dt>
            <dd class="tabular">@Job.Tasks.Count</dd>
        </div>
    </dl>

    @if (Requirements.Count > 0)
    {
        <div class="job-reqs">
            <p class="job-reqs-label">Requires</p>
            <ul class="job-req-list">
                @foreach (var requirement in Requirements)
                {
                    <li class="job-req @(requirement.Met ? "met" : "unmet")">
                        <Icon Name="@(requirement.Met ? "check" : "lock")" />
                        <span>@requirement.Label</span>
                        <span class="visually-hidden">@(requirement.Met ? ", met" : ", not met yet")</span>
                    </li>
                }
            </ul>
        </div>
    }

    @if (OnAccept.HasDelegate)
    {
        <div class="job-actions">
            <button type="button" class="btn btn-primary" disabled="@(!CanAccept || IsLocked || Busy)"
                    aria-describedby="@(Note is not null ? NoteId : null)" @onclick="OnAccept">
                Accept contract
            </button>
            @if (Note is not null)
            {
                <p id="@NoteId" class="job-note">@Note</p>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public Job Job { get; set; } = default!;
    [Parameter] public IReadOnlyList<JobRequirement> Requirements { get; set; } = [];
    [Parameter] public bool CanAccept { get; set; } = true;
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnAccept { get; set; }

    private bool IsLocked => Requirements.Any(r => !r.Met);

    private string? Note => IsLocked
        ? "Unlocks at " + string.Join(" and ", Requirements.Where(r => !r.Met).Select(r => r.Label)) + "."
        : DisabledReason;

    private string HeadingId => "job-" + Job.Id;
    private string NoteId => "job-note-" + Job.Id;
}
