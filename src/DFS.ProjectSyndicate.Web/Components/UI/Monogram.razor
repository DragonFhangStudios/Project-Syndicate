@* Initials crest used in place of a character portrait. *@
<span class="monogram monogram-@Size" aria-hidden="true">@Initials</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string Size { get; set; } = "md";

    private string Initials => string.Concat(
        Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
