@page "/play/{CharacterId}/jobs"
@inject IJobCatalog Jobs
@inject CareerService Careers
@inject PlayerState State

<PageTitle>Job board · Project Syndicate</PageTitle>

<PlayerGate CharacterId="@CharacterId" Context="player">
    @{
        var activeJob = Careers.ActiveJob(player);
        int done = player.JobData.CurrentTaskIndex;
    }
    <div class="page">
        <header class="page-header">
            <div class="page-header-text">
                <p class="eyebrow eyebrow-crimson">Civilian career</p>
                <h1>Job board</h1>
                <p class="lede">Honest work, honest pay. Take a contract, see every task through, and collect your earnings.</p>
                <p class="muted">Pay and XP are paid in full when you finish the whole contract. Per-task figures are averages for comparing jobs.</p>
            </div>
        </header>

        @if (State.LastReward is { } reward)
        {
            <RewardBanner @ref="_banner" Eyebrow="Contract complete" Title="@reward.JobTitle"
                          Cash="reward.Cash" Xp="reward.XP" LevelsGained="reward.LevelsGained" NewLevel="reward.NewLevel"
                          OnDismiss="State.DismissReward" />
        }
        else if (State.LastResult is { Success: false } failure)
        {
            <Notice Tone="warning">
                <p>@failure.Message</p>
            </Notice>
        }

        @if (activeJob is not null)
        {
            <Panel Eyebrow="Active contract" Title="@activeJob.Title" Variant="accent">
                <Actions>
                    <span class="pay-chip tabular">@Format.Money(activeJob.Payout) · +@activeJob.XPReward XP</span>
                </Actions>
                <ChildContent>
                    <p class="muted">@activeJob.Description</p>
                    <ProgressMeter Label="Progress" Value="done" Max="activeJob.Tasks.Count"
                                   ValueText="@($"{done} of {activeJob.Tasks.Count} tasks")" />
                    <TaskChecklist Tasks="activeJob.Tasks" CompletedCount="done" />
                    <div class="job-cta">
                        <button type="button" class="btn btn-primary" disabled="@State.Busy" @onclick="CompleteTaskAsync">
                            <Icon Name="check" />
                            @(done == activeJob.Tasks.Count - 1 ? "Finish the job" : "Complete task"): @activeJob.Tasks[done]
                        </button>
                        @if (done == activeJob.Tasks.Count - 1)
                        {
                            <p class="muted">Last task. You'll be paid when it's done.</p>
                        }
                    </div>
                </ChildContent>
            </Panel>
        }

        @{
            var listed = Jobs.All
                .Select(job => (Job: job, Requirements: JobEligibility.Requirements(player, job)))
                .ToList();
            // Open work by rank, the character's best rank first, and the best-paid work first within it,
            // so promotions bring the better contracts to the top.
            var openGroups = listed
                .Where(j => j.Requirements.All(r => r.Met))
                .GroupBy(j => Math.Max(1, j.Job.MinTier))
                .OrderByDescending(g => g.Key)
                .Select(g => (Tier: g.Key, Jobs: g.OrderByDescending(j => j.Job.Payout).ToList()))
                .ToList();
            int openCount = openGroups.Sum(g => g.Jobs.Count);
            bool grouped = openGroups.Count > 1;
            // Locked work nearest-unlock first: lowest rank, then lowest level, then pay.
            var locked = listed
                .Where(j => j.Requirements.Any(r => !r.Met))
                .OrderBy(j => j.Job.MinTier).ThenBy(j => j.Job.MinLevel).ThenBy(j => j.Job.Payout)
                .ToList();
        }

        <section class="stack" aria-labelledby="available-heading">
            <div class="section-title">
                <h2 id="available-heading">Available now</h2>
                <span class="muted">@openCount of @listed.Count open · @player.JobData.JobsCompleted completed</span>
            </div>
            @foreach (var group in openGroups)
            {
                string groupId = $"open-tier-{group.Tier}";
                <div class="stack job-group" role="@(grouped ? "group" : null)" aria-labelledby="@(grouped ? groupId : null)">
                    @if (grouped)
                    {
                        <h3 id="@groupId" class="job-group-title">
                            @(group.Tier <= 1 ? "Open to everyone" : $"{ProgressionManager.GetTierName(group.Tier)} contracts")
                            <span class="muted">@(group.Tier <= 1 ? "No rank needed" : $"Tier {group.Tier} and up")</span>
                        </h3>
                    }
                    <div class="grid grid-2">
                        @foreach (var (job, requirements) in group.Jobs)
                        {
                            bool isActive = activeJob?.Id == job.Id;
                            <JobCard @key="job.Id" Job="job" Requirements="requirements" HeadingLevel="@(grouped ? 4 : 3)"
                                     CanAccept="activeJob is null" Busy="State.Busy" IsActive="isActive" TasksDone="done"
                                     DisabledReason="@(activeJob is null ? null : "Finish your active contract first.")"
                                     OnAccept="() => AcceptAsync(job.Id)" />
                        }
                    </div>
                </div>
            }
        </section>

        @if (locked.Count > 0)
        {
            <section class="stack" aria-labelledby="locked-heading">
                <div class="section-title">
                    <div>
                        <h2 id="locked-heading">Locked</h2>
                        <p class="muted">Level up and earn promotions to open better-paying work.</p>
                    </div>
                </div>
                <div class="grid grid-2">
                    @foreach (var (job, requirements) in locked)
                    {
                        <JobCard @key="job.Id" Job="job" Requirements="requirements"
                                 CanAccept="false" Busy="State.Busy" OnAccept="() => AcceptAsync(job.Id)" />
                    }
                </div>
            </section>
        }
    </div>
</PlayerGate>

@code {
    [Parameter] public string CharacterId { get; set; } = string.Empty;

    private RewardBanner? _banner;
    private bool _focusBanner;

    private async Task AcceptAsync(string jobId) => await State.AcceptJobAsync(jobId);

    private async Task CompleteTaskAsync()
    {
        var result = await State.CompleteTaskAsync();
        // The task button disappears with the last task; move focus to the reward instead.
        _focusBanner = result?.Reward is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBanner && _banner is not null)
        {
            _focusBanner = false;
            await _banner.FocusAsync();
        }
    }
}
