@page "/"
@inject GameService Game
@inject PlayerState State

<PageTitle>Choose your character · Project Syndicate</PageTitle>

<div class="page">
    <header class="page-header select-hero">
        <div class="page-header-text">
            <p class="eyebrow eyebrow-crimson">Civilian career</p>
            <h1>Choose your character</h1>
            <p class="lede">Every empire starts on a street corner. Create someone new or pick up where you left off, take honest work, and build a career the city can't ignore.</p>
        </div>
    </header>

    <Notice Tone="info" Title="Local prototype">
        <p>Characters are saved on this computer only. There is no sign-in: anyone using this computer can play any character here.</p>
    </Notice>

    @if (_created is null || _demo is null)
    {
        <p class="muted" role="status">Loading characters…</p>
    }
    else
    {
        <section class="stack" aria-labelledby="yours-heading">
            <div class="section-title">
                <h2 id="yours-heading">Your characters</h2>
                <span class="muted">@(_created.Count == 0 ? "None yet" : $"{_created.Count} saved")</span>
            </div>
            <div class="grid grid-3">
                <CreateCharacterForm />
                @foreach (var character in _created)
                {
                    <CharacterCard @key="character.Id" Character="character" />
                }
            </div>
        </section>

        <section class="stack" aria-labelledby="demo-heading">
            <div class="section-title">
                <div>
                    <h2 id="demo-heading">Demo characters</h2>
                    <p class="muted">Development test profiles. Their progress is saved like any other character.</p>
                </div>
            </div>
            <div class="grid grid-3">
                @foreach (var character in _demo)
                {
                    <CharacterCard @key="character.Id" Character="character" />
                }
            </div>
        </section>
    }
</div>

@code {
    private IReadOnlyList<CharacterSummary>? _created;
    private IReadOnlyList<CharacterSummary>? _demo;

    protected override async Task OnInitializedAsync()
    {
        // Leaving a character: the navigation and stat bar go back to the selection state.
        State.Clear();
        (_created, _demo) = await Game.ListCharactersAsync();
    }
}
